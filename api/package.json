{
  "name": "@wsp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "user:create": "tsx --env-file=.env src/scripts/create-user.ts",
    "ai:try": "tsx --env-file=.env src/scripts/try-extraction.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.70",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "^7.0.148",
    "baileys": "7.0.0-rc14",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@wsp/contracts": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
